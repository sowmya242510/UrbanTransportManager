methodsFor: 'nil' stamp: '3/22/2026 08:55'!getDriverInfo    ^ 'Driver ID: ', driverID asString,      ' | Name: ', name,      ' | Rating: ', rating asString,      ' | Total Rides: ', assignedRides size asString.! !Smalltalk globals removeClassNamed: #AnObsoleteDriver!Object subclass: #Driver    instanceVariableNames: 'driverID name rating assignedRides'    classVariableNames: ''    package: 'RideSharing'.!!Driver methodsFor: 'nil' stamp: '3/22/2026 08:57'!initializeWithID: anID name: aName rating: aRating    driverID := anID.    name := aName.    rating := aRating.    assignedRides := OrderedCollection new.! !!Driver methodsFor: 'nil' stamp: '3/22/2026 08:58'!addRide: aRide    assignedRides add: aRide.! !!Driver methodsFor: 'nil' stamp: '3/22/2026 08:58'!getDriverInfo    ^ 'Driver ID: ', driverID asString,      ' | Name: ', name,      ' | Rating: ', rating asString,      ' | Total Rides: ', assignedRides size asString.! !Object subclass: #Rider    instanceVariableNames: 'riderID name requestedRides'    classVariableNames: ''    package: 'RideSharing'.!!Rider methodsFor: 'nil' stamp: '3/22/2026 08:58'!initializeWithID: anID name: aName    riderID := anID.    name := aName.    requestedRides := OrderedCollection new.! !!Rider methodsFor: 'nil' stamp: '3/22/2026 08:58'!requestRide: aRide    requestedRides add: aRide.! !!Rider methodsFor: 'nil' stamp: '3/22/2026 08:59'!viewRides    requestedRides do: [:ride |        Transcript show: ride rideDetails; cr.    ].! !----QUIT/NOSAVE----2026-03-22T10:20:21.709+05:30 RideSharingSystem.image priorSource: 314!----QUIT/NOSAVE----2026-03-22T10:20:21.791+05:30 RideSharingSystem.image priorSource: 314!Object << #Ride    slots: {#rideID. #pickupLocation. #dropoffLocation. #distance};    sharedVariables: {};    package: 'RideSharing'!!Ride methodsFor: 'nil' stamp: '3/22/2026 10:28'!setDistance: dist    distance := dist.! !!Ride methodsFor: 'nil' stamp: '3/22/2026 10:29'!setRideID: id    rideID := id.! !!Ride methodsFor: 'nil' stamp: '3/22/2026 10:29'!setPickup: pickup    pickupLocation := pickup.! !!Ride methodsFor: 'nil' stamp: '3/22/2026 10:30'!setDropoff: dropoff    dropoffLocation := dropoff.! !!Ride methodsFor: 'nil' stamp: '3/22/2026 10:30'!fare    ^ distance * 10.! !!Ride methodsFor: 'accessing' stamp: '3/22/2026 10:32'!rideDetails    Transcript show: 'Ride ID: ', rideID printString; cr.    Transcript show: 'From: ', pickupLocation, ' To: ', dropoffLocation; cr.    Transcript show: 'Distance: ', distance printString; cr.! !!Ride methodsFor: 'accessing' stamp: '3/22/2026 10:32' prior: 8739!rideDetails    Transcript        show: 'Ride ID: ', rideID printString; cr;        show: 'From: ', pickupLocation, ' To: ', dropoffLocation; cr;        show: 'Distance: ', distance printString; cr.! !!Ride methodsFor: 'accessing' stamp: '3/22/2026 10:33' prior: 9297!rideDetails    Transcript        show: 'Ride ID: ', rideID printString; cr;        show: 'From: ', pickupLocation, ' To: ', dropoffLocation; cr;        show: 'Distance: ', distance printString; cr.    ^ self! !!Ride methodsFor: 'accessing' stamp: '3/22/2026 10:33' prior: 9843!rideDetails    Transcript        show: 'Ride ID: ', rideID printString; cr;        show: 'From: ', pickupLocation, ' To: ', dropoffLocation; cr;        show: 'Distance: ', distance printString; cr.    ^ self.! !!Ride methodsFor: 'accessing' stamp: '3/22/2026 10:34' prior: 10411!rideDetails    Transcript        show: 'Ride ID: ', rideID printString; cr;        show: 'From: ', pickupLocation, ' To: ', dropoffLocation; cr;        show: 'Distance: ', distance printString; cr.    ^ self.! !!Ride methodsFor: 'accessing' stamp: '3/22/2026 10:34' prior: 10983!rideDetails    Transcript        show: 'Ride ID: ', rideID printString; cr;        show: 'From: ', pickupLocation, ' To: ', dropoffLocation; cr;        show: 'Distance: ', distance printString; cr.    ^ self.! !Ride << #StandardRide    slots: {};    sharedVariables: {};    package: 'RideSharing'!!StandardRide methodsFor: 'nil' stamp: '3/22/2026 10:36'!fare    ^ distance * 10.! !Ride << #PremiumRide    slots: {};    sharedVariables: {};    package: 'RideSharing'!!PremiumRide methodsFor: 'nil' stamp: '3/22/2026 10:37'!fare    ^ distance * 20.! !Object << #Driver    slots: {#driverID. #name. #rating. #assignedRides};    sharedVariables: {};    package: 'RideSharing'!!Driver methodsFor: 'nil' stamp: '3/22/2026 10:41'!initialize    assignedRides := OrderedCollection new.! !!Driver methodsFor: 'nil' stamp: '3/22/2026 10:41'!setDetails: id name: n rating: r    driverID := id.    name := n.    rating := r.! !!Driver methodsFor: 'nil' stamp: '3/22/2026 10:41'!addRide: ride    assignedRides add: ride.! !!Driver methodsFor: 'nil' stamp: '3/22/2026 10:42'!getDriverInfo    Transcript        show: 'Driver: ', name; cr;        show: 'Rating: ', rating printString; cr;        show: 'Total Rides: ', assignedRides size printString; cr.    ^ self.! !!Driver methodsFor: 'as yet unclassified' stamp: '3/22/2026 10:42' prior: 13755!getDriverInfo    Transcript        show: 'Driver: ', name; cr;        show: 'Rating: ', rating printString; cr;        show: 'Total Rides: ', assignedRides size printString; cr.    ^ self.! !Object << #Rider    slots: {#riderID. #name. #requestedRides};    sharedVariables: {};    package: 'RideSharing'!!Rider methodsFor: 'nil' stamp: '3/22/2026 10:43'!initialize    requestedRides := OrderedCollection new.! !!Rider methodsFor: 'nil' stamp: '3/22/2026 10:43'!setDetails: id name: n    riderID := id.    name := n.! !!Rider methodsFor: 'nil' stamp: '3/22/2026 10:44'!requestRide: ride    requestedRides add: ride.! !!Rider methodsFor: 'nil' stamp: '3/22/2026 10:44'!viewRides    requestedRides do: [:ride |        ride rideDetails.        Transcript show: 'Fare: ', ride fare printString; cr.    ].    ^ self.! !--